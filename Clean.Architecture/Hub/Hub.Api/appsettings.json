{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "SignalR": {
    "ClientTimeoutSeconds": 30,
    "KeepAliveSeconds": 15
  },
  "Hub": {
    "ArrivalThresholdMeters": 500
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Identity": {
    "Issuer": "http://localhost:6001/"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "admin",
    "Password": "",
    "VirtualHost": "/",
    "Port": "5672",
    "PerChannelQos": 0,
    "PerConsumerQos": 15
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  }
}
