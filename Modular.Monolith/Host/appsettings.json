{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "SignalR": {
    "ClientTimeoutSeconds": 30,
    "KeepAliveSeconds": 15
  },
  "Hub": {
    "ArrivalThresholdMeters": 500
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Identity": {
    "Issuer": "http://localhost:5400/",
    "AccessTokenLifetimeHours": 12,
    "IdentityTokenLifetimeHours": 12,
    "RefreshTokenLifetimeDays": 30
  },
  "Redis": {
    "ConnectionString": "redis:6379",
    "DefaultExpirationMinutes": 60
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 60,
    "QueueLimit": 2,
    "EndpointLimits": {
      "identity_token": {
        "PermitLimit": 10,
        "Window": 60,
        "Policy": "fixed"
      },
      "identity_register": {
        "PermitLimit": 5,
        "Window": 3600,
        "Policy": "fixed"
      },
      "driver_api": {
        "PermitLimit": 1000,
        "Window": 60,
        "Policy": "fixed"
      },
      "driver_registration": {
        "PermitLimit": 5,
        "Window": 3600,
        "Policy": "fixed"
      },
      "driver_status_update": {
        "PermitLimit": 60,
        "Window": 60,
        "Policy": "fixed"
      },
      "driver_location_update": {
        "PermitLimit": 120,
        "Window": 60,
        "Policy": "fixed"
      },
      "driver_status": {
        "PermitLimit": 30,
        "Window": 60,
        "Policy": "fixed"
      },
      "driver_search": {
        "PermitLimit": 30,
        "Window": 60,
        "Policy": "fixed"
      },
      "ride_api": {
        "PermitLimit": 1000,
        "Window": 60,
        "Policy": "fixed"
      },
      "ride_request": {
        "PermitLimit": 10,
        "Window": 60,
        "Policy": "fixed"
      },
      "ride_cancellation": {
        "PermitLimit": 5,
        "Window": 60,
        "Policy": "fixed"
      },
      "ride_location": {
        "PermitLimit": 120,
        "Window": 60,
        "Policy": "fixed"
      }
    }
  },
  "DistanceWeight": 0.7,
  "RatingWeight": 0.3,
  "UserMinRating": 0.0,
  "UserMaxRating": 5.0,
  "AverageSpeedKmh": 30.0,
  "MorningPeakMultiplier": 1.5,
  "EveningPeakMultiplier": 1.6,
  "NightMultiplier": 0.8,
  "LunchMultiplier": 1.3,
  "BaseFare": 2.5,
  "PerKmRate": 1.2,
  "PerMinuteRate": 0.25,
  "ConnectionStrings": {
    "IdentityContext": "Server=tcp:localhost,1433;Initial Catalog=identity;Persist Security Info=False;User ID=sa;Password=;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;",
    "DriverContext": "Server=tcp:localhost,1433;Initial Catalog=driver;Persist Security Info=False;User ID=sa;Password=;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;",
    "RideContext": "Server=tcp:localhost,1433;Initial Catalog=ride;Persist Security Info=False;User ID=sa;Password=;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  }
}
