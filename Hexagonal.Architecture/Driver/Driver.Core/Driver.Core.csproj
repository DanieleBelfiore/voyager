<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Description>The hexagon: Driver entities, primary/secondary ports, and use cases. No EF Core, no ASP.NET Core, no Kaido/RabbitMQ — only Hikyaku's IRequestHandler&lt;T&gt; marker interfaces, which double as the primary port shape (see Ports/Primary). References Commons/Voyager.Contracts for cross-service message shapes only.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Commons\Voyager.Errors\Voyager.Errors.csproj" />
    <ProjectReference Include="..\..\..\Commons\Voyager.Contracts\Voyager.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hikyaku" Version="10.0.1" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>
</Project>
