# Copy to .env and set real values. Do not commit .env.
# Used by docker-compose.yml to avoid hardcoded credentials.

# SQL Server "sa" password (also used by identity-api/driver-api/ride-api connection strings).
DB_SA_PASSWORD=

# RabbitMQ password for the "admin" user (also used by identity-api/driver-api/ride-api/hub-api).
RABBITMQ_PASSWORD=
