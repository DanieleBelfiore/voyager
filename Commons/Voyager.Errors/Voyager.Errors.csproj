<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Authors>Daniele Belfiore</Authors>
    <Description>Exception types only — no logic, no dependencies, not even a framework reference. Exists so a pure Domain/Core layer can signal "this violates a business rule" in a type the HTTP layer can map to a status code, without the domain taking on an ASP.NET Core or EF Core reference.</Description>
  </PropertyGroup>
</Project>
