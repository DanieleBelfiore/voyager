<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Authors>Daniele Belfiore</Authors>
    <Description>Wire contracts (request/response shapes only, no logic) for cross-service RPC between Voyager bounded contexts over the message bus. Shared across architecture variants so Kaido's type-name-based routing stays compatible regardless of each service's internal layering.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hikyaku.Contracts" Version="9.1.2" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>
</Project>
