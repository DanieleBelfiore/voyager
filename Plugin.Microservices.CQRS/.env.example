# Copy this file to .env and set your own values.
# docker-compose reads these to configure infrastructure credentials
# instead of relying on the hardcoded defaults.

# SQL Server `sa` account password (used by sqlserver, sqlserver-init, and each service's connection string)
DB_SA_PASSWORD=

# RabbitMQ admin password (used by rabbitmq and each service's RabbitMQ__Password)
RABBITMQ_PASSWORD=
