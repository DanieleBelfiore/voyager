{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Identity": {
    "Issuer": "http://localhost:6001/",
    "AccessTokenLifetimeHours": 12,
    "IdentityTokenLifetimeHours": 12,
    "RefreshTokenLifetimeDays": 30
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "admin",
    "Password": "",
    "VirtualHost": "/",
    "Port": "5672",
    "PerChannelQos": 0,
    "PerConsumerQos": 15
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 60,
    "QueueLimit": 2,
    "EndpointLimits": {
      "identity_token": {
        "PermitLimit": 10,
        "Window": 60,
        "Policy": "fixed"
      },
      "identity_register": {
        "PermitLimit": 5,
        "Window": 3600,
        "Policy": "fixed"
      }
    }
  },
  "ConnectionStrings": {
    "IdentityContext": "Server=tcp:localhost,1433;Initial Catalog=identity;Persist Security Info=False;User ID=sa;Password=;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  }
}
