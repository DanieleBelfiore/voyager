{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Identity": {
    "Issuer": "http://localhost:6001/"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "admin",
    "Password": "",
    "VirtualHost": "/",
    "Port": "5672",
    "PerChannelQos": 0,
    "PerConsumerQos": 15
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 60,
    "QueueLimit": 2,
    "EndpointLimits": {
      "ride_api": {
        "PermitLimit": 1000,
        "Window": 60,
        "Policy": "fixed"
      },
      "ride_request": {
        "PermitLimit": 10,
        "Window": 60,
        "Policy": "fixed"
      },
      "ride_cancellation": {
        "PermitLimit": 5,
        "Window": 60,
        "Policy": "fixed"
      },
      "ride_location": {
        "PermitLimit": 120,
        "Window": 60,
        "Policy": "fixed"
      }
    }
  },
  "AverageSpeedKmh": 30.0,
  "ConnectionStrings": {
    "RideContext": "Server=tcp:localhost,1433;Initial Catalog=ride;Persist Security Info=False;User ID=sa;Password=;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  }
}
